{
  "name": "@hanaworlds/contract-inspector",
  "version": "0.1.0",
  "description": "合约检查器：在 Host 中检查建筑与区域 JSON，展示公开协议声明。样例为 fixture。",
  "type": "module",
  "license": "MIT",
  "exports": { ".": "./src/host.mjs", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["src/host.mjs", "src/inspection.mjs", "lib/client.js", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": ">=24.0.0" },
  "peerDependencies": {
    "hanaworlds-contracts": "0.5.3",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "hanaworlds-contracts": { "optional": true },
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-connection"]
    }
  }
}
